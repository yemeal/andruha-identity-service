SERVICE_NAME=andruha-identity-service
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
DEV_LOGS=true
LOG_LEVEL=INFO
MUTE_LOGGERS=uvicorn.access,sqlalchemy
DATABASE_HOST=identity-postgres
DATABASE_PORT=5432
DATABASE_USER=andruha_identity
DATABASE_PASSWORD=identity-local-only
DATABASE_NAME=andruha_identity
RUN_MIGRATIONS=false
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_KEY_NAMESPACE=andruha-identity-service:idempotency:v1
IDEMPOTENCY_LEASE_SECONDS=30
IDEMPOTENCY_RESULT_TTL_SECONDS=300
JWT_PRIVATE_KEY_PATH=/run/secrets/identity_jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/identity_jwt_public_key
JWT_ACTIVE_KEY_ID=identity-v1
JWT_ISSUER=andruha-identity-service
JWT_SERVICE_AUDIENCE=andruha-identity-service
JWT_AUDIENCES=andruha-identity-service,andruha-api-gateway,andruha-user-profile-service,andruha-messages-dialogues-service,andruha-websocket-gateway-service,andruha-object-storage-service
REPLAY_ENCRYPTION_ACTIVE_KEY_ID=replay-v1
REPLAY_ENCRYPTION_KEY_PATHS=replay-v1=/run/secrets/identity_replay_key
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TEST_TOKEN_ENDPOINT_ENABLED=false
